{
  "name": "oistudy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "parse": "node scripts/parse-tests.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs --subject do",
    "seed:upsert": "node --env-file=.env.local scripts/seed.mjs --subject do --only-upsert",
    "seed:categorize": "node --env-file=.env.local scripts/seed.mjs --subject do --only-categorize",
    "explain": "node --env-file=.env.local scripts/explain.mjs --subject do",
    "explain:redo": "node --env-file=.env.local scripts/explain.mjs --subject do --redo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "16.2.6",
    "openai": "^4.73.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
