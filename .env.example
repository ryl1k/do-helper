# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
SUPABASE_BUCKET=questions

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# App API keys (comma-separated, you hand these out to your users)
APP_API_KEYS=xxxxxx

# Optional: hard cap (USD) per day, request 402 once exceeded
DAILY_USD_CAP=1.50
